+static void OpenErrorHelp(ErrorBoxParam &error)
+{
+	TCHAR help_file[MAX_PATH];
+	TCHAR temp_dir[MAX_PATH];
+	if (!GetTempPath(_countof(temp_dir), temp_dir))
+	{
+		MsgBox(_T("无法创建错误帮助页面。"));
+		return;
+	}
+	sntprintf(help_file, _countof(help_file), _T("%sAutoHotkey-ErrorHelp-%lu.html"), temp_dir, GetCurrentProcessId());
+
+	CStringW html;
+	html += L"<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><title>AutoHotkey 错误帮助</title>";
+	html += L"<style>body{font-family:\"Microsoft YaHei\",Segoe UI,sans-serif;line-height:1.6;margin:28px;max-width:960px;color:#17202a}"
+		L"h1{font-size:24px;margin:0 0 12px}h2{font-size:18px;margin-top:24px}.box{border:1px solid #d8dfe6;border-radius:6px;padding:14px 16px;background:#f8fafb}"
+		L"dt{font-weight:700;margin-top:10px}dd{margin:4px 0 0 0;white-space:pre-wrap}.code{font-family:Consolas,monospace;background:#fff;border:1px solid #d8dfe6;border-radius:4px;padding:8px}"
+		L"a{color:#1769aa}li{margin:10px 0}</style></head><body>";
+	html += L"<h1>AutoHotkey 错误帮助</h1><p>这是根据当前错误自动生成的中文说明，供定位问题时参考。</p>";
+
+	html += L"<section class=\"box\"><h2>当前错误</h2><dl>";
+	AppendHelpRow(html, L"错误", error.text);
+	AppendHelpRow(html, L"具体信息", error.info);
+	if (error.line)
+	{
+		TCHAR line_number[32];
+		sntprintf(line_number, _countof(line_number), _T("%d"), error.line->mLineNumber);
+		AppendHelpRow(html, L"文件", Line::sSourceFile[error.line->mFileIndex]);
+		AppendHelpRow(html, L"行号", line_number);
+		TCHAR line_text[LINE_SIZE];
+		error.line->ToText(line_text, _countof(line_text), true);
+		html += L"<dt>代码</dt><dd class=\"code\">";
+		AppendHtmlEscaped(html, line_text);
+		html += L"</dd>";
+	}
+	else
+	{
+		TCHAR line_number[32];
+		sntprintf(line_number, _countof(line_number), _T("%d"), g_script.CurrentLine());
+		AppendHelpRow(html, L"文件", g_script.CurrentFile());
+		AppendHelpRow(html, L"行号", line_number);
+	}
+	html += L"</dl></section>";
+
+	html += L"<section><h2>可能原因和解决办法</h2>";
+	AppendErrorAdvice(html, error);
+	html += L"</section>";
+
+	html += L"<section><h2>中文文档</h2><p><a href=\"https://wyagd001.github.io/v2/docs/\">AutoHotkey v2 中文文档首页</a>。"
+		L"如果是 RMT 宏执行时报错，先回到 RMT 中检查正在运行的宏、当前指令和变量输出。</p></section>";
+	html += L"</body></html>";
+
+	if (!WriteUtf8File(help_file, html))
+	{
+		MsgBox(_T("无法写入错误帮助页面。"));
+		return;
+	}
+	if (!g_script.ActionExec(help_file, NULL, NULL, false))
+		MsgBox(_T("无法打开错误帮助页面。"));
+}
