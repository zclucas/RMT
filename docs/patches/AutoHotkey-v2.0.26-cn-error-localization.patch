+static bool ContainsAny(LPCTSTR aText, std::initializer_list<LPCTSTR> aNeedles)
+{
+	if (!aText)
+		return false;
+	for (auto needle : aNeedles)
+		if (needle && *needle && _tcsstr(aText, needle))
+			return true;
+	return false;
+}
+
+static bool ErrorContainsAny(ErrorBoxParam &error, std::initializer_list<LPCTSTR> aNeedles)
+{
+	return ContainsAny(error.text, aNeedles) || ContainsAny(error.info, aNeedles);
+}
+
+static void AppendHtmlEscaped(CStringW &html, LPCTSTR text)
+{
+	if (!text)
+		return;
+	CStringW converted;
+	auto src = StringTCharToWChar(text, converted);
+	for (auto ch = src; *ch; ++ch)
+	{
+		switch (*ch)
+		{
+		case L'&': html += L"&amp;"; break;
+		case L'<': html += L"&lt;"; break;
+		case L'>': html += L"&gt;"; break;
+		case L'"': html += L"&quot;"; break;
+		default: html += *ch;
+		}
+	}
+}
+
+static void AppendHelpRow(CStringW &html, LPCWSTR label, LPCTSTR value)
+{
+	if (!value || !*value)
+		return;
+	html += L"<dt>";
+	html += label;
+	html += L"</dt><dd>";
+	AppendHtmlEscaped(html, value);
+	html += L"</dd>";
+}
+
+static void AppendAdvice(CStringW &html, LPCWSTR title, LPCWSTR body, LPCWSTR link = nullptr)
+{
+	html += L"<li><b>";
+	html += title;
+	html += L"</b><p>";
+	html += body;
+	if (link && *link)
+	{
+		html += L" <a href=\"";
+		html += link;
+		html += L"\">打开相关中文文档</a>";
+	}
+	html += L"</p></li>";
+}
+
