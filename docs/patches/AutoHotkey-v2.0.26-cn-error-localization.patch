+		add_advice(L"类型不匹配",
+			L"某个位置需要数字、字符串、对象、数组或回调，但实际传入了另一种值。优先检查变量是否为空、是否被当成数字使用、数组/对象字段是否存在。",
+			L"https://wyagd001.github.io/v2/docs/Variables.htm");
+
+	if (ErrorContainsAny(error, {_T("未设置"), _T("unset"), _T("Unset"), _T("尚未")}))
+		add_advice(L"变量还没有赋值",
+			L"脚本正在读取一个尚未赋值的变量。给变量设置默认值，或在读取前用 IsSet 判断。RMT 中常见原因是宏变量名写错、上一步指令没有产生输出、或变量作用域不一致。",
+			L"https://wyagd001.github.io/v2/docs/Variables.htm");
+
+	if (ErrorContainsAny(error, {_T("找不到"), _T("不存在"), _T("not found"), _T("Not found"), _T("cannot find"), _T("does not exist")}))
+		add_advice(L"文件、窗口、资源或成员不存在",
+			L"检查路径是否真实存在、相对路径是否以当前工作目录为准、文件是否已随发行包复制。若错误来自窗口/控件操作，确认目标窗口标题、进程名、类名或句柄仍然有效。",
+			L"https://wyagd001.github.io/v2/docs/lib/FileExist.htm");
+
+	if (ErrorContainsAny(error, {_T("Missing"), _T("缺少"), _T("括号"), _T("引号"), _T("\")"), _T("\"]"), _T("\"}")}))
+		add_advice(L"语法结构不完整",
+			L"常见原因是少了右括号、右方括号、右大括号、引号或逗号。检查高亮行和它上一行，尤其是跨行表达式、函数调用和数组/对象字面量。",
+			L"https://wyagd001.github.io/v2/docs/Language.htm");
+
+	if (ErrorContainsAny(error, {_T("没有名为"), _T("no method"), _T("no property"), _T("method"), _T("property")}))
+		add_advice(L"对象属性或方法名不正确",
+			L"检查对象是否为预期类型、属性/方法名是否拼写正确，以及是否把数组、字符串或空值当成对象使用。",
+			L"https://wyagd001.github.io/v2/docs/Objects.htm");
+
+	if (ErrorContainsAny(error, {_T("无法"), _T("cannot"), _T("failed"), _T("Failed"), _T("拒绝访问"), _T("access")}))
+		add_advice(L"系统调用或外部程序失败",
+			L"检查权限、目标程序是否存在、路径是否带引号、文件是否被占用。涉及游戏或管理员窗口时，RMT 和目标程序的权限级别也需要一致。",
+			L"https://wyagd001.github.io/v2/docs/lib/Run.htm");
+
+	if (!advice_count)
