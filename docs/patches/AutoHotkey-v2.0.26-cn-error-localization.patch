+static bool WriteUtf8File(LPCTSTR path, LPCWSTR text)
+{
+	CStringA utf8;
+	StringWCharToUTF8(text, utf8);
+	HANDLE file = CreateFile(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+	if (file == INVALID_HANDLE_VALUE)
+		return false;
+
+	DWORD written;
+	BYTE bom[] = { 0xEF, 0xBB, 0xBF };
+	bool ok = WriteFile(file, bom, sizeof(bom), &written, NULL)
+		&& written == sizeof(bom)
+		&& WriteFile(file, utf8.GetString(), (DWORD)utf8.GetLength(), &written, NULL);
+	CloseHandle(file);
+	return ok;
+}
