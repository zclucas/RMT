// ========== Tab7: 工具 ==========
function renderToolTab() {
    return `
<div class="tab-panel tab-tool">
    <div class="tool-grid">
        <div class="tool-card" onclick="openTool('record')">
            <div class="tool-icon">🎤</div>
            <div class="tool-name">录制宏</div>
            <div class="tool-desc">录制键盘鼠标操作</div>
        </div>
        <div class="tool-card" onclick="openTool('searchImg')">
            <div class="tool-icon">🔍</div>
            <div class="tool-name">图片搜索</div>
            <div class="tool-desc">查找屏幕上指定图片</div>
        </div>
        <div class="tool-card" onclick="openTool('searchColor')">
            <div class="tool-icon">🎨</div>
            <div class="tool-name">颜色搜索</div>
            <div class="tool-desc">查找屏幕上指定颜色</div>
        </div>
        <div class="tool-card" onclick="openTool('ocr')">
            <div class="tool-icon">📝</div>
            <div class="tool-name">文字识别</div>
            <div class="tool-desc">OCR 识别屏幕文字</div>
        </div>
        <div class="tool-card" onclick="openTool('run')">
            <div class="tool-icon">⚡</div>
            <div class="tool-name">运行程序</div>
            <div class="tool-desc">运行外部程序</div>
        </div>
        <div class="tool-card" onclick="openTool('variable')">
            <div class="tool-icon">📦</div>
            <div class="tool-name">变量管理</div>
            <div class="tool-desc">管理系统变量</div>
        </div>
        <div class="tool-card" onclick="openTool('compare')">
            <div class="tool-icon">📋</div>
            <div class="tool-name">文本对比</div>
            <div class="tool-desc">对比两份文本差异</div>
        </div>
        <div class="tool-card" onclick="openTool('loop')">
            <div class="tool-icon">🔁</div>
            <div class="tool-name">循环测试</div>
            <div class="tool-desc">测试宏循环执行</div>
        </div>
        <div class="tool-card" onclick="openTool('input')">
            <div class="tool-icon">⌨️</div>
            <div class="tool-name">自定义输入</div>
            <div class="tool-desc">自定义键盘输入</div>
        </div>
        <div class="tool-card" onclick="openTool('mouse')">
            <div class="tool-icon">🖱️</div>
            <div class="tool-name">鼠标录制</div>
            <div class="tool-desc">录制鼠标操作</div>
        </div>
        <div class="tool-card" onclick="openTool('bgmouse')">
            <div class="tool-icon">📍</div>
            <div class="tool-name">后台鼠标</div>
            <div class="tool-desc">后台鼠标操作</div>
        </div>
        <div class="tool-card" onclick="openTool('output')">
            <div class="tool-icon">💬</div>
            <div class="tool-name">输出信息</div>
            <div class="tool-desc">输出提示信息</div>
        </div>
    </div>
</div>`;
}

