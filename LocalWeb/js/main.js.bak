// ========== 工具函数 ==========

// 休眠切换
function onSuspendChange() {
    if (window.ahk && window.ahk.SuspendToggle) {
        window.ahk.SuspendToggle();
    }
}

// 暂停切换
function onPauseChange() {
    if (window.ahk && window.ahk.PauseToggle) {
        window.ahk.PauseToggle();
    }
}

// 终止所有宏
function killAllMacro() {
    var ahk = getAhkObj();
    if (ahk) {
        ahk.KillAllMacro();
    }
}

// 保存设置
function saveSetting() {
    var ahk = getAhkObj();
    if (ahk && ahk.SaveSetting) {
        try {
            ahk.SaveSetting();
            console.log('保存成功');
            // 保存后刷新当前Tab数据
            var content = document.getElementById('tabContent');
            if (content && currentTabIndex >= 1 && currentTabIndex <= 6) {
                // 刷新宏编辑Tab
                updateTabContent(currentTabIndex);
            }
        } catch(e) {
            console.log('保存失败:', e.message || e);
        }
    }
}

// 重载
function reloadApp() {
    var ahk = getAhkObj();
    if (ahk) {
        ahk.Reload();
    }
}

// 打开配置管理
function openSettingMgr() {
    var ahk = getAhkObj();
    if (ahk) {
        ahk.ShowSettingMgr();
    }
}

// 打开工具
function openTool(toolName) {
    var ahk = getAhkObj();
    if (ahk && ahk.OpenTool) {
        ahk.OpenTool(toolName);
    }
}

// 显示帮助
function showHelp() {
    var ahk = getAhkObj();
    if (ahk) {
        ahk.ShowHelp();
    } else {
        window.location.href = 'index.html';
    }
}

// 接收 AHK 消息
function onAHKMessage(msg) {
    console.log('收到 AHK 消息:', msg);

    if (msg.action === 'initData' && msg.data) {
        renderUI(msg.data);
    } else if (msg.action === 'tabChanged' && msg.data) {
        switchTab(msg.data.tabIndex);
    }
}

// 导出给 AHK 调用
window.onAHKMessage = onAHKMessage;
